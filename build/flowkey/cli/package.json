{
  "name": "@flowkey-mini/cli",
  "version": "0.4.0",
  "description": "Build, validate, package and install FlowKey extensions.",
  "type": "module",
  "bin": {
    "flowkey": "dist/cli.js"
  },
  "files": [
    "dist",
    "shims",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielSantos23/flowkey-launcher.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "@flowkey-mini/native-sdk": "0.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://github.com/GabrielSantos23/flowkey-launcher#readme",
  "bugs": {
    "url": "https://github.com/GabrielSantos23/flowkey-launcher/issues"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:esbuild --external:commander --external:fflate && node scripts/copy-shims.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
