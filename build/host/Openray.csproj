<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Openray.Launcher</RootNamespace>
    <AssemblyName>Openray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <!-- Shell icon extraction (`System.Drawing.Icon.ExtractAssociatedIcon`). -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- WinRT projections for `Windows.Media.Ocr` come from the net9.0-windows10.0.x target
         framework; no extra reference package is needed. -->
  </ItemGroup>

</Project>
