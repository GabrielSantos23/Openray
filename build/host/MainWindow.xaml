<!-- Code-behind-free shell: the window is composed entirely in MainWindow.xaml.cs so the
     WebView2 wiring sits next to the layout. `AllowsTransparency` + a solid-root window is required
     for Raycast's 8px window radius and its large soft drop shadow to be visible. -->
<Window x:Class="Openray.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openray"
        Height="480" Width="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Root"
            Background="#CC333333"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Direction="-90" ShadowDepth="10"
                              Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        </Grid>
    </Border>
</Window>
