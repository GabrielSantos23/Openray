{
  "id": "contract-probe",
  "name": "contract-probe",
  "version": "1.0.0",
  "description": "FlowKey backend contract probe",
  "entry": "main.js",
  "commands": [
    { "id": "open", "title": "Open", "mode": "view" },
    { "id": "tick", "title": "Tick", "mode": "background" }
  ],
  "nativeMethods": ["storage.*", "system.selectedText", "oauth.authorize", "oauth.status", "secrets.*", "image.fetch", "http.fetch"],
  "httpHosts": ["api.spotify.com", "i.scdn.co", "127.0.0.1"],
  "oauth": ["spotify"],
  "preferences": [
    { "name": "sampleText", "type": "text", "title": "Sample text", "default": "fallback" }
  ]
}
